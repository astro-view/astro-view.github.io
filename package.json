{
  "name": "astro-view",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AstroView - Milky Way photography planner",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "data:stars": "node scripts/build-star-catalog.mjs",
    "data:milkyway": "node scripts/build-milkyway-texture.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
